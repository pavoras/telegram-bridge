# Public host name of the relay (DNS must point to this server; Caddy gets the certificate).
DOMAIN=tg.example.com

# From @BotFather. Keep this file private (chmod 600). Alternatively mount a secret file and
# set TG_BOT_TOKEN_FILE=/run/secrets/tg-bot-token instead.
TG_BOT_TOKEN=

# Language of the bot's own texts (en or de) and the time zone for times and the daily report.
TG_LANGUAGE=en
TG_TIMEZONE=UTC

# Optional. Empty: pair your chat by sending "/start <code>" (code in `docker compose logs relay`).
TG_ALLOWED_CHAT_ID=

# Optional: a JSON file with extra tokens and limited rights, e.g. for a server monitor:
#   {"server-monitor": {"sha256": "<sha256 of its token>", "rights": ["report", "host-status"]}}
# Mount it into the relay container and point TG_CLIENTS_FILE at it.
# TG_CLIENTS_FILE=/run/secrets/tg-clients.json
